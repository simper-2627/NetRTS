<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <Description>Manual play client: a person plays NetRts in the browser as an ordinary API player (fogged state, same tick and rate limits as a bot).</Description>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- NetRtsClient uses reflection-based System.Text.Json; trim only the framework, never our assemblies. -->
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetRts.Protocol\NetRts.Protocol.csproj" />
    <ProjectReference Include="..\..\src\NetRts.Bots\NetRts.Bots.csproj" />
    <ProjectReference Include="..\..\src\NetRts.Web.Rendering\NetRts.Web.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetRts.PlayClient.Tests" />
  </ItemGroup>

</Project>
