<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <Description>Manual play client: a person plays NetRts in the browser as an ordinary API player (fogged state, same tick and rate limits as a bot).</Description>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- NetRtsClient uses reflection-based System.Text.Json; trim only the framework, never our assemblies. -->
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetRts.Protocol\NetRts.Protocol.csproj" />
    <ProjectReference Include="..\..\src\NetRts.Bots\NetRts.Bots.csproj" />
  </ItemGroup>

  <!-- The spectator site's map renderer, vocabulary, theme toggle and Snow College "S", used where they
       are (so upstream changes to them arrive here too) and served at the same paths as on that site.
       ContentRoot lets `dotnet run` serve them from the server's wwwroot; Link alone only works for publish. -->
  <PropertyGroup>
    <SpectatorWwwroot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'src', 'NetRts.Server', 'wwwroot'))</SpectatorWwwroot>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(SpectatorWwwroot)mapview.js;$(SpectatorWwwroot)util.js;$(SpectatorWwwroot)lore.js;$(SpectatorWwwroot)theme.js"
             Link="wwwroot\%(Filename)%(Extension)" ContentRoot="$(SpectatorWwwroot)" />
    <Content Include="$(SpectatorWwwroot)images\snow-s-*.png"
             Link="wwwroot\images\%(Filename)%(Extension)" ContentRoot="$(SpectatorWwwroot)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetRts.PlayClient.Tests" />
  </ItemGroup>

</Project>
